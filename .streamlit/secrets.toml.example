# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud ▸ your app ▸ Settings ▸ Secrets.   Never commit the real file.

# ---- Sign-in codes (OTP) ----
# demo    = any 6 digits sign in (no SMS)            ← default
# console = real random code, printed in the app logs (set SHOW_CODE_ON_SCREEN = true for class demos)
# twilio  = Twilio Verify sends real SMS
# msg91   = MSG91 sends real SMS (Indian DLT templates)
OTP_PROVIDER = "demo"
SHOW_CODE_ON_SCREEN = false

TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN = ""
TWILIO_VERIFY_SERVICE_SID = ""

MSG91_AUTH_KEY = ""
MSG91_TEMPLATE_ID = ""

# ---- AI assistant (Claude) ----  Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY = ""
ANTHROPIC_MODEL = "claude-haiku-5-5"
